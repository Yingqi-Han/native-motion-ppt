{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native Motion shared document v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "slides"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "title": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "font": {
          "type": "string"
        },
        "latin_font": {
          "type": "string"
        },
        "background": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{6}$"
        },
        "foreground": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{6}$"
        }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "objects"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,100}$"
          },
          "label": {
            "type": "string"
          },
          "duration": {
            "type": "number",
            "minimum": 100
          },
          "background": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f]{6}$"
          },
          "notes": {
            "type": "string"
          },
          "clicks": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0
            }
          },
          "objects": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/object"
            }
          },
          "transition": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "none",
                  "fade",
                  "push",
                  "wipe",
                  "morph"
                ]
              },
              "duration": {
                "type": "number",
                "minimum": 0
              },
              "direction": {
                "enum": [
                  "l",
                  "r",
                  "u",
                  "d"
                ]
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "box"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,100}$"
        },
        "kind": {
          "enum": [
            "text",
            "rect",
            "ellipse",
            "line",
            "polygon",
            "group",
            "path"
          ]
        },
        "box": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        },
        "fill": {
          "type": "string",
          "pattern": "^(?:[0-9A-Fa-f]{6}|none)$"
        },
        "stroke": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{6}$"
        },
        "stroke_width": {
          "type": "number",
          "minimum": 0
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rotation": {
          "type": "number"
        },
        "text": {
          "type": "string"
        },
        "size": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "font": {
          "type": "string",
          "minLength": 1
        },
        "align": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "spacing": {
          "type": "number"
        },
        "bold": {
          "type": "boolean"
        },
        "line_height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "advances": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "points": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          }
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/object"
          }
        },
        "animations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/animation"
          }
        },
        "gradient": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "to"
          ],
          "properties": {
            "from": {
              "type": "string",
              "pattern": "^[0-9A-Fa-f]{6}$"
            },
            "to": {
              "type": "string",
              "pattern": "^[0-9A-Fa-f]{6}$"
            },
            "angle": {
              "type": "number"
            }
          }
        },
        "d": {
          "type": "string",
          "minLength": 1
        },
        "commands": {
          "type": "array"
        },
        "radius": {
          "type": "number",
          "minimum": 0
        },
        "role": {
          "enum": [
            "title",
            "body",
            "data",
            "visual",
            "caption",
            "label",
            "decoration"
          ]
        },
        "reveal_group": {
          "type": "integer",
          "minimum": 1
        },
        "allow_overflow": {
          "type": "boolean"
        },
        "allow_overlap": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "text"
              }
            }
          },
          "then": {
            "required": [
              "text"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "polygon"
              }
            }
          },
          "then": {
            "required": [
              "points"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "group"
              }
            }
          },
          "then": {
            "required": [
              "objects"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "path"
              }
            }
          },
          "then": {
            "required": [
              "d"
            ]
          }
        }
      ]
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "enter",
            "exit",
            "move",
            "rotate",
            "scale"
          ]
        },
        "effect": {
          "enum": ["fade", "wipe"]
        },
        "direction": {
          "enum": ["up", "down", "left", "right"]
        },
        "at": {
          "type": "number",
          "minimum": 0
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "click": {
          "type": "integer",
          "minimum": 0
        },
        "loop": {
          "type": "boolean"
        },
        "ambient": {
          "type": "boolean"
        },
        "auto_reverse": {
          "type": "boolean"
        },
        "by_letter": {
          "type": "boolean"
        },
        "letter_delay": {
          "type": "number",
          "minimum": 0
        },
        "from": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "to": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "path": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          }
        },
        "degrees": {
          "type": "number"
        },
        "accel": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "decel": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
