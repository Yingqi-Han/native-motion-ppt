          "text": "NATIVE / 01",
          "box": [
            90,
            96,
            800,
            64
          ],
          "font": "Space Grotesk SemiBold",
          "size": 29,
          "fill": "626775",
          "role": "label"
        },
        {
          "id": "title",
          "kind": "text",
          "text": "先说明条件。",
          "box": [
            90,
            245,
            900,
            230
          ],
          "font": "Noto Serif CJK SC",
          "bold": true,
          "size": 98,
          "role": "title"
        },
        {
          "id": "body",
          "kind": "text",
          "text": "观众需要先知道，\n变化从哪里开始。",
          "box": [
            92,
            655,
            880,
            240
          ],
          "size": 46,
          "role": "body",
          "reveal_group": 1
        },
        {
          "id": "baseline",
          "kind": "path",
          "d": "M 0 270 C 220 30 480 370 760 0",
          "box": [
            105,
            990,
            790,
            280
          ],
          "fill": "none",
          "stroke": "4049E8",
          "stroke_width": 5,
          "role": "visual"
        }
