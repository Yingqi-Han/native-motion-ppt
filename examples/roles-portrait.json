    },
    {
      "id": "change",
      "label": "变化",
      "duration": 5000,
      "transition": {
        "kind": "morph",
        "duration": 520
      },
      "objects": [
        {
          "id": "label2",
          "kind": "text",
          "text": "NATIVE / 02",
          "box": [
            90,
            96,
            800,
            64
          ],
          "font": "Space Grotesk SemiBold",
          "size": 29,
          "fill": "626775",
          "role": "label"
        },
        {
          "id": "title2",
          "kind": "text",
          "text": "再展示变化。",
          "box": [
            90,
            245,
            900,
            230
          ],
          "font": "Noto Serif CJK SC",
          "bold": true,
          "size": 98,
          "role": "title"
        },
        {
          "id": "body2",
          "kind": "text",
          "text": "用同一个对象，\n把前后关系接起来。",
          "box": [
            92,
            655,
            880,
            240
          ],
          "size": 46,
          "role": "body",
          "reveal_group": 1
        },
        {
          "id": "baseline",
          "kind": "path",
          "d": "M 0 270 C 260 370 570 30 760 0",
          "box": [
            105,
            990,
            790,
            280
          ],
          "fill": "none",
