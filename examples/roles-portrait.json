{
  "version": 1,
  "title": "Portrait motion / 版式适配",
  "canvas": {
    "width": 1080,
    "height": 1350,
    "fps": 60
  },
  "theme": {
    "font": "Noto Sans CJK SC",
    "background": "F2EEE6",
    "foreground": "171A20",
    "accent": "4049E8"
  },
  "slides": [
