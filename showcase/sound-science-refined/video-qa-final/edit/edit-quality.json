  "sentence_audio_checks": [
    {
      "scene": "question",
      "cue": 0,
      "text": "声音传过来，空气也会一路跑过来吗？",
      "normalized_correlation": 0.999985749490977,
      "offset_seconds": 0.0
    },
    {
      "scene": "question",
      "cue": 1,
      "text": "盯住这个橙色标记。",
      "normalized_correlation": 0.9999861052429598,
      "offset_seconds": 0.0
    },
    {
      "scene": "parcel",
      "cue": 0,
      "text": "它在平衡位置附近，来回振动。",
      "normalized_correlation": 0.9999885208221896,
      "offset_seconds": 0.0
    },
    {
      "scene": "parcel",
      "cue": 1,
      "text": "图示是空气团的平均运动，没有画出热运动。",
      "normalized_correlation": 0.9999751185856599,
      "offset_seconds": 0.0
    },
    {
      "scene": "compression",
      "cue": 0,
      "text": "向右走的是压缩区。",
      "normalized_correlation": 0.9999689176324809,
      "offset_seconds": 0.0
    },
    {
      "scene": "compression",
      "cue": 1,
      "text": "相邻的空气接力振动，把疏密变化传向前方。",
      "normalized_correlation": 0.9999889198539625,
      "offset_seconds": 0.0
    },
    {
      "scene": "parallel",
      "cue": 0,
      "text": "空气的振动方向，与声波的传播方向平行。",
      "normalized_correlation": 0.9999809815104176,
      "offset_seconds": 0.0
    },
    {
      "scene": "parallel",
      "cue": 1,
      "text": "这就是空气中的纵波。",
      "normalized_correlation": 0.9999856234554386,
      "offset_seconds": 0.0
    },
    {
      "scene": "frequency",
      "cue": 0,
      "text": "波速近似不变时，频率翻倍，波长减半。",
      "normalized_correlation": 0.9999936532683517,
      "offset_seconds": 0.0
    },
    {
      "scene": "frequency",
      "cue": 1,
      "text": "先听二百二十赫兹，再听四百四十赫兹。",
      "normalized_correlation": 0.9999769444171239,
      "offset_seconds": 0.0
    },
    {
      "scene": "wavelength",
      "cue": 0,
      "text": "二十摄氏度时，空气中的声速约为每秒三百四十三米。",
      "normalized_correlation": 0.9999768139515114,
      "offset_seconds": 0.0
    },
    {
      "scene": "wavelength",
      "cue": 1,
      "text": "波长等于声速除以频率。",
      "normalized_correlation": 0.9999772524629866,
      "offset_seconds": 0.0
    },
    {
      "scene": "wavelength",
      "cue": 2,
      "text": "三百四十三除以四百四十，约等于零点七八米。",
      "normalized_correlation": 0.9999469244077375,
      "offset_seconds": 0.0
    },
    {
      "scene": "recap",
      "cue": 0,
      "text": "所以，传过去的是振动。",
      "normalized_correlation": 0.9999915268555287,
      "offset_seconds": 0.0
    },
    {
      "scene": "recap",
      "cue": 1,
      "text": "空气只在附近往复，声波把能量传向远方。",
      "normalized_correlation": 0.9999802720032547,
      "offset_seconds": 0.0
    }
